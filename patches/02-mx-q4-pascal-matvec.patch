+#pragma once
+#include "common.cuh"
+
+// 0 = off, 1 = smem (stock layout), 2 = repack; from GGML_CUDA_MX_Q4
+int ggml_cuda_mx_q4_mode();
+
+// y = W x for one column. W: Q4_0 [nrows, ncols], contiguous rows. x: already quantized to q8_1.
+// Returns false if it did not run (caller then uses mul_mat_vec_q).
+bool ggml_cuda_mx_q4_mul_mat_vec(const void * src0_d, const void * src1_q8_1, float * dst_d,
+                                 int64_t ncols, int64_t nrows, cudaStream_t stream);
